  "info": {
    "_postman_id": "4c6f03d8-ca8c-470e-9649-76e46828b187",
    "name": "Post Analytics Upload API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Upload-Post API is a universal social media publishing interface for publishing videos, photos, and text posts to TikTok, Instagram, YouTube, LinkedIn, Facebook, X (Twitter), Threads, Pinterest, Bluesky, Reddit, Discord, Telegram, and Google Business Profile. It also manages user profiles, single-use JWT account-linking URLs, upload status/history, and cross-platform analytics.\n\nContact Support:\n Name: Upload-Post Support",
      "type": "text/plain"
    }
  }
