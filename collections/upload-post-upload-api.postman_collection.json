          "name": "Upload a video post",
          "request": {
            "name": "Upload a video post",
            "description": {
              "content": "Publishes a video to one or more social platforms for a given user profile. Sent as multipart/form-data. Supports synchronous and asynchronous (async_upload=true returns a request_id) operation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "user",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Username of the profile to publish on behalf of."
                },
                {
                  "key": "platform[]",
                  "value": "[\"<string>\",\"<string>\"]",
                  "type": "text",
                  "description": "(Required) One or more target platforms."
                },
                {
                  "key": "video",
                  "type": "file",
                  "description": "(Required) Video file (multipart) or a publicly accessible video URL."
                },
                {
                  "key": "title",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Title/caption of the video post."
                },
                {
                  "key": "async_upload",
                  "value": "<boolean>",
                  "type": "text",
                  "description": "When true, processes the upload asynchronously and returns a request_id."
                },
                {
                  "key": "scheduled_date",
                  "value": "<dateTime>",
                  "type": "text",
                  "description": "ISO 8601 timestamp to schedule the post for future publishing."
                }
              ]
            }
